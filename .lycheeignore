# URL patterns lychee skips when checking links in doc/, llms.txt and *.md.
# Every line is a REGULAR EXPRESSION, not a glob.
#
# Add a host here only when it is auth-walled, rate-limited, or a placeholder in
# a code sample. Real rot belongs in the report, not in this file.

# GitHub auth wall: the login redirect answers with a 404 to an unauthenticated
# CI runner.
^https://github\.com/login

# A private vulnerability report needs a signed-in session.
^https://github\.com/anilcancakir/dowel/security/advisories/new

# The doc pages are published with the docs site at a release tag; until then
# they answer 404.
# Added 2026-11-13: remove this line once the docs site serves /dowel/docs.
^https://anilcancakir\.com/dowel/docs(?:[/?#]|$)

# The pub.dev pages exist only after the first publish.
# Added 2026-11-13: remove these lines once dowel is on pub.dev.
^https://pub\.dev/packages/dowel
^https://pub\.dev/documentation/dowel

# The tapir and crumbs docs pages exist only once their docs sync runs.
# Added 2026-11-13: remove these lines once tapir and crumbs are published.
^https://anilcancakir\.com/tapir/docs
^https://anilcancakir\.com/crumbs/docs

# Placeholder hosts inside example code.
^https?://([a-z0-9-]+\.)*example\.com
^https?://localhost
^https?://127\.0\.0\.1
